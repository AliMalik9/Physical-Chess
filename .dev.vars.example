# Copy to `.dev.vars` for local development. `.dev.vars` is gitignored.
#
# BoardLink has no accounts, so there are no third-party API keys here. The only
# configuration is origin allow-listing and tuning knobs for room lifetime.

# Comma-separated list of origins permitted to open a WebSocket upgrade.
# Leave empty to allow same-origin only, which is what you want locally.
# Production example: ALLOWED_ORIGINS=https://boardlink.example.com
ALLOWED_ORIGINS=

# Minutes an unjoined, empty room survives before it is deleted. Default 60.
EMPTY_ROOM_TTL_MINUTES=60

# Hours an active but idle game survives before it is deleted. Default 24.
ACTIVE_ROOM_TTL_HOURS=24

# Hours a finished game is retained so both players can still download the PGN.
COMPLETED_ROOM_TTL_HOURS=24

# Multiplies every per-IP rate limit. Local requests carry no CF-Connecting-IP,
# so they all share one bucket; raise this for development and e2e runs.
# Leave unset in production.
RATE_LIMIT_MULTIPLIER=200
