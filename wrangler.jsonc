{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boardlink",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    // The SPA serves four client-side routes; unknown paths fall back to
    // index.html so /room/:id and /join deep links work on a cold load.
    "not_found_handling": "single-page-application",
    // Bound explicitly so the Worker can hand non-/api/ requests to the assets
    // service itself, rather than relying on run-before-worker routing.
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed Durable Objects are required for the storage API used here.
      "new_sqlite_classes": ["GameRoom", "RateLimiter"]
    }
  ],
  "vars": {
    // Comma-separated list of origins allowed to open a WebSocket. Empty in dev
    // means "same origin only". Override per environment in the dashboard.
    "ALLOWED_ORIGINS": ""
  }
}
